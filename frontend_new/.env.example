# URL base del backend (RobotLoro/backend/server.py). Vacío = mismo origen:
# en desarrollo Vite reenvía /api a VITE_PROXY_TARGET; en producción el backend sirve el dashboard.
VITE_API_URL=

# Backend al que Vite reenvía /api durante `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# true = usa datos simulados (sin backend). false = llama al backend real.
VITE_USE_MOCKS=false
